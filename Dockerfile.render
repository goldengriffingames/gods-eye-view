# Prebuild Vite assets, then run the preview server instead of Vite's dev server.
FROM node:24.14.0-slim AS build
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24.14.0-slim
WORKDIR /app
ENV NODE_ENV=production PUPPETEER_SKIP_DOWNLOAD=1 PORT=4173
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 4173
CMD ["node","scripts/render-preview.mjs"]
